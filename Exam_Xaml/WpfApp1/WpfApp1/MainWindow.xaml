<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        x:Class="WpfApp1.MainWindow" 
        Width="820" Title="직원 정보 관리" Height="536">
    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Padding" Value="8"></Setter>
            <Setter Property="Margin" Value="0,0,0,8"></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
            <Setter Property="Background" Value="White"></Setter>
        </Style>
        
        <Style x:Key="SelectedButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
            <Setter Property="Background" Value="#DBE8F6"/>
            <Setter Property="FontWeight" Value="Bold"></Setter>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"></Setter>
        </Style>
        
    </Window.Resources>
    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="SteelBlue" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="직원 정보 등록" Margin="12,0" FontSize="18" Foreground="White" Grid.Column="0"/>
                <TextBlock VerticalAlignment="Center" Text="홍길동 님 · 인사팀" Opacity="0.6" Margin="12,0" FontSize="10" Foreground="White" Grid.Column="1"/>
            </Grid>
        </Border>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="LightGray" Background="#F3F5F8">
                <StackPanel Margin="10">
                    <Button Content="직원 목록" Style="{StaticResource MenuButton}"/>
                    <Button Content="직원 등록" Style="{StaticResource SelectedButton}"/>
                    <Button Content="부서 관리" Style="{StaticResource MenuButton}"/>
                    <Button Content="설정" Margin="0" Style="{StaticResource MenuButton}"/>
                </StackPanel>
            </Border>
            
            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="기본 정보" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"></TextBlock>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Grid.Row="0" Text="사번" Style="{StaticResource FormLabel}"></TextBlock>
                    <TextBox Grid.Column="1" Grid.Row="0" Width="220" HorizontalAlignment="Left"></TextBox>
                </Grid>
            </Grid>
        </Grid>
        
        <Border Grid.Row="2" BorderThickness="0,1,0,1" BorderBrush="Gray">
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8" HorizontalAlignment="Right">
                <Button Width="90" Padding="1,5,1,5" Margin="0,0,8,0" FontSize="13" Content="저장"/>
                <Button Width="90" Padding="1,5,1,5" FontSize="13" Content="취소"/>
            </StackPanel>
        </Border>
        <StatusBar Grid.Row="3">
            <StatusBarItem Content="준비"/>
            <StatusBarItem Content="입력 항목 6개" HorizontalAlignment="Right" FontSize="12" Opacity="0.6" Margin="0,0,5,0"/>
        </StatusBar>
    </Grid>
</Window>