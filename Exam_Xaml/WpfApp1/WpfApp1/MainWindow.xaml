<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        x:Class="WpfApp1.MainWindow" 
        Width="820" Title="직원 정보 관리" Height="540" WindowStartupLocation="CenterScreen" MinWidth="600" MinHeight="540">
    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Padding" Value="8"></Setter>
            <Setter Property="Margin" Value="0,0,0,8"></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
            <Setter Property="Background" Value="White"></Setter>
        </Style>

        <Style x:Key="SelectedButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
            <Setter Property="Background" Value="#DBE8F6"/>
            <Setter Property="FontWeight" Value="Bold"></Setter>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"></Setter>
            <Setter Property="Padding" Value="0,10,0,10"></Setter>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="15"></Setter>
            <Setter Property="Padding" Value="3,5,0,5"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
        </Style>

        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="15"></Setter>
            <Setter Property="Padding" Value="3,5,0,5"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
        </Style>

        <Style x:Key="FormDate" TargetType="DatePicker">
            <Setter Property="FontSize" Value="15"></Setter>
            <Setter Property="Padding" Value="3,5,0,5"></Setter>

            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="SteelBlue" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="직원 정보 등록" Margin="12,0" FontSize="18" Foreground="White" Grid.Column="0"/>
                <TextBlock VerticalAlignment="Center" Text="홍길동 님 · 인사팀" Opacity="0.6" Margin="12,0" FontSize="12" Foreground="White" Grid.Column="1"/>
            </Grid>
        </Border>


        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderThickness="0,0,1,0" BorderBrush="LightGray" Background="#F3F5F8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Button Content="직원 목록" Style="{StaticResource MenuButton}"/>
                        <Button Content="직원 등록" Style="{StaticResource SelectedButton}"/>
                        <Button Content="부서 관리" Style="{StaticResource MenuButton}"/>
                        <Button Content="설정" Margin="0" Style="{StaticResource MenuButton}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="기본 정보" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"></TextBlock>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Grid.Row="0" Text="사번" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Grid.Row="0" Width="220" Text="{Binding EmployeeNo}" Style="{StaticResource FormTextBox}"></TextBox>

                    <TextBlock Grid.Column="0" Grid.Row="1" Text="이름" Style="{StaticResource FormLabel}"></TextBlock>
                    <TextBox Grid.Column="1" Grid.Row="1" Width="220" Text="{Binding Name, UpdateSourceTrigger =PropertyChanged}" Style="{StaticResource FormTextBox}"></TextBox>

                    <TextBlock Grid.Column="0" Grid.Row="2" Text="부서" Style="{StaticResource FormLabel}"></TextBlock>
                    <ComboBox Grid.Column="1" Grid.Row="2" Width="220" Style="{StaticResource FormCombo}" ItemsSource="{Binding Departments}" SelectedItem="{Binding Department}">
                    </ComboBox>

                    <TextBlock Grid.Column="0" Grid.Row="3" Text="입사일" Style="{StaticResource FormLabel}"></TextBlock>
                    <DatePicker Grid.Column="1" Grid.Row="3" Style="{StaticResource FormDate}" Width="220" SelectedDate="{Binding HireDate}"></DatePicker>

                    <TextBlock Grid.Column="0" Grid.Row="4" Text="이메일" Style="{StaticResource FormLabel}"></TextBlock>
                    <TextBox Grid.Column="1" Grid.Row="4" Width="Auto" Text="{Binding Email}" Style="{StaticResource FormTextBox}" HorizontalAlignment="Stretch"></TextBox>

                    <TextBlock Grid.Column="0" Grid.Row="5" Text="메모" Style="{StaticResource FormLabel}"></TextBlock>
                    <TextBox Grid.Column="1" Grid.Row="5" Padding="3,5,0,0" FontSize="13" Text="{Binding Memo}" 
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"></TextBox>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderThickness="0,1,0,1" BorderBrush="Gray">
            <StackPanel Orientation="Horizontal" Margin="8" HorizontalAlignment="Right">
                <Button x:Name="BtnLoad" Width="90" Padding="1,5,1,5" Margin="0,0,8,0" FontSize="13" Content="불러오기" Click="BtnLoad_Click"/>
                <Button x:Name="BtnSave" Width="90" Padding="1,5,1,5" Margin="0,0,8,0" FontSize="13" Content="저장" Click="BtnSave_Click" IsEnabled="{Binding CanSave}"/>
                <Button Width="90" Padding="1,5,1,5" FontSize="13" Content="취소"/>
            </StackPanel>
        </Border>
        <StatusBar Grid.Row="3">
            <StatusBarItem Content="준비"/>
            <StatusBarItem Content="{Binding Summary}" HorizontalAlignment="Right" FontSize="12" Opacity="0.6" Margin="0,0,5,0"/>
        </StatusBar>
    </Grid>
</Window>